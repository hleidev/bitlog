<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.harrylei.bitlog.user.repository.mapper.UserMapper">

    <resultMap id="UserDetailDTOMap" type="top.harrylei.bitlog.user.model.dto.UserDetailDTO">
        <id column="id" property="userId"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="avatar" property="avatar"/>
        <result column="position" property="position"/>
        <result column="company" property="company"/>
        <result column="profile" property="profile"/>
        <result column="extend" property="extend"/>
        <result column="user_role" property="userRole"/>
    </resultMap>

    <select id="pageUsers" resultMap="UserDetailDTOMap">
        select
            a.id, a.username, a.email, a.status, a.user_role, a.deleted, a.create_time, a.update_time,
            b.avatar
        from user_account a
        left join user_info b on a.id = b.user_id
        where a.deleted = #{queryParam.deletedFilter}
        <if test="queryParam.statusFilter != null">and a.status = #{queryParam.statusFilter}</if>
        <include refid="userKeywordFilter"/>
    </select>

    <!--
      列表与计数共用的关键词谓词。计数不带 deleted/status 条件——四个档位由 FILTER 分桶，
      但关键词必须与列表一致，否则搜索时 tab 数字和列表行数会对不上。
    -->
    <sql id="userKeywordFilter">
        <if test="queryParam.keyword != null and queryParam.keyword.trim() != ''">
            and a.username like concat('%', #{queryParam.keyword}, '%')
        </if>
    </sql>

    <select id="selectUserStats" resultType="top.harrylei.bitlog.user.model.dto.UserStatsDTO">
        select
            COUNT(*) FILTER (WHERE a.deleted = 0)                  AS total,
            COUNT(*) FILTER (WHERE a.deleted = 0 AND a.status = 1) AS enabled,
            COUNT(*) FILTER (WHERE a.deleted = 0 AND a.status = 0) AS disabled,
            COUNT(*) FILTER (WHERE a.deleted = 1)                  AS deactivated
        from user_account a
        <where>
            <include refid="userKeywordFilter"/>
        </where>
    </select>

    <select id="selectUserDetail" resultMap="UserDetailDTOMap">
        select
            a.id, a.username, a.email, a.status, a.user_role, a.deleted, a.create_time, a.update_time,
            b.avatar, b.position, b.company, b.profile, b.extend
        from user_account a
        left join user_info b on a.id = b.user_id
        where a.id = #{userId}
    </select>

</mapper>

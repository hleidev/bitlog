<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.harrylei.bitlog.article.repository.mapper.ArticleVersionMapper">

    <!-- 查询文章的最大版本号，不存在时返回 0 -->
    <select id="getMaxVersion" resultType="int">
        SELECT COALESCE(MAX(version), 0)
        FROM article_version
        WHERE article_id = #{articleId}
    </select>

    <!-- fetchSize 取 Integer.MIN_VALUE 是 MySQL 驱动开启流式读取的约定值，不设则整个结果集仍会先缓冲到驱动端 -->
    <select id="scanContentFromActiveArticles" resultType="string" fetchSize="-2147483648"
            resultSetType="FORWARD_ONLY">
        SELECT av.content
        FROM article_version av
        INNER JOIN article a ON av.article_id = a.id
        WHERE a.deleted = 0
    </select>

</mapper>

# 本地开发用。复制为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不要提交
#
# 由 application.yml 的 spring.config.import 直接读取（Spring Boot 原生能力，不需要 direnv）。
# 路径相对于进程工作目录，所以启动命令必须从 bitlog-backend/ 执行。
#
# 这不是仓库根目录那个 .env —— 那份是 docker-compose 部署用的，键名不同，两者不可互换。
#
# 语法是 Java properties：# 开头是注释，第一个 = 之后全是值，值里的反斜杠需要写成 \\。
# 所有变量均无默认值，缺任何一项启动即失败并指明是哪一项。
#
# profile 不在这里配。SPRING_PROFILES_ACTIVE 写在本文件里是无效的（导入后键名不会被映射成
# spring.profiles.active），dev 已是 application.yml 里的默认档；要临时切档用启动参数：
#   java -jar ... --spring.profiles.active=xxx

# --- 数据库（dev: localhost:5432/bitlog）---
DB_USERNAME=
DB_PASSWORD=

# --- Redis（dev: 127.0.0.1:6379, db 12）---
REDIS_PASSWORD=

# --- 对象存储 MinIO（dev: localhost:19000）---
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI（阿里云百炼 / DashScope）---
# https://bailian.console.aliyun.com/
QWEN_API_KEY=

# --- 邮件发送（Resend）---
# https://resend.com/api-keys
MAIL_API_KEY=

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# client-id 是公开信息，已写在 application.yml 里；这里只填 secret
GOOGLE_CLIENT_SECRET=

# --- JWT 签名密钥 ---
# HS256，至少 32 字节。生成：openssl rand -base64 48
JWT_SECRET=

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>top.harrylei.bitlog</groupId>
        <artifactId>bitlog-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>bitlog-common-web</artifactId>
    <name>bitlog-common-web</name>
    <description>Web 基础设施：Spring MVC、Security、MyBatis-Plus、Redis 相关配置</description>

    <dependencies>
        <!-- 核心基础模块（POJO、枚举、工具类、异常体系） -->
        <dependency>
            <groupId>top.harrylei.bitlog</groupId>
            <artifactId>bitlog-common-core</artifactId>
        </dependency>

        <!-- Redis（optional：仅在使用 Redis 的服务中生效） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MyBatis-Plus（MybatisPlusConfig 分页插件，BaseDO @TableId，optional：仅在使用 DB 的服务中生效） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Security（SecurityConfig、GatewayAuthenticationFilter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web MVC（GlobalExceptionHandler 的 @RestControllerAdvice 等注解） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- 各服务本身也会引入 web starter，common 只做编译依赖，不额外打包 Tomcat -->
            <optional>true</optional>
        </dependency>

        <!-- Bean Validation（StringToDeleteStatusEnumConverter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok（编译期代码生成，provided 不打入 jar） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

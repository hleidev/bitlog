{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@bitlog/editor": ["./packages/editor/src/index.ts"],
      "@bitlog/editor/*": ["./packages/editor/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "packages/editor/src/**/*.ts",
    "packages/editor/src/**/*.vue"
  ],
  "exclude": ["src/**/__tests__/*"]
}

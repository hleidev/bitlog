{
  "name": "bitlog-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\""
  },
  "lint-staged": {
    "src/**/*.{vue,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": "prettier --write"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/vue": "^7.21.1",
    "@types/markdown-it": "^14.1.2",
    "axios": "^1.14.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.6",
    "element-plus": "^2.13.6",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "md-editor-v3": "^6.5.0",
    "mermaid": "^11.15.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/dompurify": "^3.0.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.8"
  },
  "volta": {
    "node": "22.22.2"
  }
}
